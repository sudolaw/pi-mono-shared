{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["es2023", "dom"],
    "types": ["node"],
    "strict": false,
    "strictNullChecks": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.js"]
}
